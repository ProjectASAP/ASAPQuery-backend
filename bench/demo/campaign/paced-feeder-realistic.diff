+
+/// Adds `inc(idx)` for every index up to `n` to the series' running total
+/// (state), resetting to 0 where `reset(idx)`; earlier indexes restart from 0.
+fn running_total(
+    state: &std::sync::Mutex<CounterState>,
+    series: u64,
+    n: u64,
+    reset: impl Fn(u64) -> bool,
+    inc: impl Fn(u64) -> f64,
+) -> f64 {
+    let mut st = state.lock().unwrap();
+    let i = series as usize;
+    if st.next.len() <= i {
+        st.next.resize(i + 1, 0);
+        st.total.resize(i + 1, 0.0);
+    }
+    if st.next[i] > n {
+        st.next[i] = 0;
+        st.total[i] = 0.0;
+    }
+    while st.next[i] <= n {
+        let idx = st.next[i];
+        if reset(idx) {
+            st.total[i] = 0.0;
+        }
+        st.total[i] += inc(idx);
+        st.next[i] += 1;
+    }
+    st.total[i]
+}
