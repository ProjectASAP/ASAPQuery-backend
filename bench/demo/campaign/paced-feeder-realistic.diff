+/// Whether a series resets, its reset period and phase offset (samples).
+fn reset_schedule(seed: u64, series: u64, fraction: f64, min: u64, max: u64) -> (bool, u64, u64) {
+    let resets = unit_uniform(seed ^ 0x7e5e7, series, 0) < fraction;
+    let span = max.saturating_sub(min).max(1);
+    let period = min.max(1) + (unit_uniform(seed ^ 0x9e71, series, 0) * span as f64) as u64;
+    let offset = (unit_uniform(seed ^ 0x0ff5, series, 0) * period as f64) as u64;
+    (resets, period, offset)
+}
+
+fn round_to(v: f64, decimals: i32) -> f64 {
+    let f = 10f64.powi(decimals);
+    (v * f).round() / f
+}
+
+/// Smooth value noise in [-1, 1]: hashed knots every `period` samples, linearly
+/// interpolated (stateless).
+fn value_noise(seed: u64, series: u64, n: u64, period: u64) -> f64 {
+    let period = period.max(1);
+    let k = n / period;
+    let frac = (n % period) as f64 / period as f64;
+    let a = 2.0 * unit_uniform(seed ^ 0x5eed, series, k) - 1.0;
+    let b = 2.0 * unit_uniform(seed ^ 0x5eed, series, k + 1) - 1.0;
+    a + (b - a) * frac
+}
