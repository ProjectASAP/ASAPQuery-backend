+    pub reset_min: u64,
+    pub reset_max: u64,
+    /// Series of this metric per base series (this metric's extra labels vary
+    /// fastest, so base series = series / per).
+    pub per: u64,
+}
+
+/// Per-series running totals of a Zipf counter (generated in index order; a
+/// request for an earlier index recomputes from 0).
+#[derive(Debug, Default)]
+pub struct CounterState {
+    next: Vec<u64>,
+    total: Vec<f64>,
+}
+
+#[derive(Debug, Clone)]
+pub enum Realistic {
+    /// Latency-like: log-normal, median `median · scale` (the series' Zipf
+    /// scale), `sigma`, slowly drifting median (±`drift` over `drift_period`
