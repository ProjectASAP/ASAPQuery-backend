+/// Realistic values (2026-11-21, `values.realistic` in the table), in place of
+/// the independent Pareto draws / constant increments. Every value is still a
+/// pure function of (seed, series, sample index), so any sample can be
+/// regenerated independently.
+/// Zipf(s) over the integers 1..=n: the normalized CDF (shared, built once).
+#[derive(Debug)]
+pub struct ZipfTable {
+    pub s: f64,
+    pub n: u64,
+    cdf: Vec<f64>,
+}
+
+impl ZipfTable {
+    pub fn new(s: f64, n: u64) -> Self {
+        let mut cdf = Vec::with_capacity(n as usize);
+        let mut acc = 0.0;
+        for k in 1..=n {
+            acc += (k as f64).powf(-s);
+            cdf.push(acc);
+        }
+        for c in cdf.iter_mut() {
+            *c /= acc;
+        }
+        Self { s, n, cdf }
+    }
+
+    /// The integer k in 1..=n whose CDF interval holds u in (0, 1].
+    pub fn sample(&self, u: f64) -> u64 {
+        (self.cdf.partition_point(|&c| c < u) as u64 + 1).min(self.n)
+    }
+}
+
+/// A paired counter's base (2026-11-21): the Zipf counter whose increments it
+/// takes a share of (hits of lookups, errors of requests), with that base's
+/// seed, increment table and reset schedule, so the pair's resets coincide.
