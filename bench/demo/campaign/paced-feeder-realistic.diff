+    Latency { median: f64, sigma: f64, drift: f64, drift_period: u64, decimals: i32 },
+    /// Smooth gauge: `level · scale · (1 + amplitude · sin(2π n / period + φ))`
+    /// plus smooth value noise (`noise` relative, knots every `noise_period`
