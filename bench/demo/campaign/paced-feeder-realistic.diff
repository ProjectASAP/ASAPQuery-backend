+fn realistic_value(r: &Realistic, seed: u64, series: u64, scale: f64, n: u64) -> f64 {
+    match *r {
+        Realistic::Latency { median, sigma, drift, drift_period, decimals } => {
+            // Box-Muller from two hashed uniforms in (0, 1].
+            let u1 = unit_uniform(seed, series, 2 * n);
+            let u2 = unit_uniform(seed, series, 2 * n + 1);
+            let z = (-2.0 * u1.ln()).sqrt() * (std::f64::consts::TAU * u2).cos();
+            let m = median * scale * (1.0 + drift * value_noise(seed, series, n, drift_period));
+            round_to(m.max(1e-3) * (sigma * z).exp(), decimals)
+        }
+        Realistic::Smooth { level, amplitude, period, noise, noise_period, decimals } => {
+            let phase = std::f64::consts::TAU * unit_uniform(seed ^ 0xfa5e, series, 0);
+            let s = (std::f64::consts::TAU * n as f64 / period.max(1) as f64 + phase).sin();
+            let v = level * scale * (1.0 + amplitude * s + noise * value_noise(seed, series, n, noise_period));
+            round_to(v.max(0.0), decimals)
+        }
+        Realistic::Zipf { ref table, decimals, integer } => {
