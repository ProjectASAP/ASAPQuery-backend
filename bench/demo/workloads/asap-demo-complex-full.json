    "scrape_interval_ms": 100,
    "series": {
      "leaf_count": 10000,
      "ranking": {
        "exponent": 1.1,
        "kind": "deterministic_zipf_like",
        "rank_scope": "leaf_series"
      }
    }
  },
  "description": "asap-demo-complex with the original windows (planning only).",
