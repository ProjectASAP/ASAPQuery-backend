digraph compiled_physical_plan {
  rankdir=LR;
  node [shape=box, fontname=Helvetica];
  subgraph cluster_precompute {
    label="PrecomputePlan";
  }
  subgraph cluster_query_0 {
    label="QueryPlan: topk by (label_0) (3, rate(data[1m]))";
    query_0_0 [label="ExactFallback\npost-ASAP node requires exact execution", shape=doubleoctagon];
  }
}
