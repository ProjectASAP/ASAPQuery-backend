digraph compiled_physical_plan {
  rankdir=LR;
  node [shape=box, fontname=Helvetica];
  subgraph cluster_precompute {
    label="PrecomputePlan";
  }
  subgraph cluster_query_0 {
    label="QueryPlan: rate(data[1m])";
    query_0_0 [label="ExactFallback\npost-ASAP node requires exact execution", shape=doubleoctagon];
  }
  subgraph cluster_query_1 {
    label="QueryPlan: sum by (label_0) (rate(data[1m]))";
    query_1_0 [label="ExactFallback\npost-ASAP node requires exact execution", shape=doubleoctagon];
  }
  subgraph cluster_query_2 {
    label="QueryPlan: topk by (label_0) (3, rate(data[1m]))";
    query_2_0 [label="ExactFallback\npost-ASAP node requires exact execution", shape=doubleoctagon];
  }
}
